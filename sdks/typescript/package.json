{
  "name": "@operon/client",
  "version": "0.0.1",
  "description": "TypeScript client for the Operon native REST API",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.14",
    "@types/node": "~22.20.4",
    "typescript": "~7.0.2"
  }
}
