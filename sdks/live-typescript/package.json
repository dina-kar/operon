{
  "name": "@operon/live",
  "version": "0.0.1",
  "description": "The Loam Live TypeScript client: generated loam.live.v1 Connect stubs and a reactive layer.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "generate": "cd ../.. && buf generate --template buf.gen.yaml",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "node --test test/session.test.ts test/values.test.ts test/browser-safe.test.ts",
    "test:live": "node --test --test-concurrency=1 test/live.test.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@types/node": "22.20.4",
    "typescript": "7.0.2"
  }
}
