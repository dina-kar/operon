{
  "name": "@loams/plugin-stacks",
  "version": "0.1.0",
  "private": true,
  "description": "Loams Desktop's local stack page: the bundled loams sidecar's state, start, stop and restart, its log tail, and the environment switcher (design §37 §6.2, AP1 Task 3). Desktop only: it injects platform.stacks.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "platform.stacks",
        "router"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "console.nav"
      ],
      "permissions": [],
      "requires": {
        "console": "^0.1.0",
        "api": []
      },
      "editions": [
        "desktop"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/platform-tauri": "workspace:*",
    "@loams/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
