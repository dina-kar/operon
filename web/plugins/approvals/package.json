{
  "name": "@loams/plugin-approvals",
  "version": "0.1.0",
  "private": true,
  "description": "The approvals inbox: pending approvals live over WatchApprovals, with decisions, step-up and typed confirmation (design §37 §7.3, AP1a Task 8).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "loams": {
    "plugin": {
      "kind": "console",
      "entry": ".",
      "tier": "first-party",
      "inject": [
        "rpc.approvals",
        "router",
        "slots",
        "platform"
      ],
      "provides": [],
      "slots": [
        "console.page",
        "console.nav",
        "shell.overlay"
      ],
      "permissions": [
        "approvals:read",
        "approvals:decide",
        "ui:notifications"
      ],
      "requires": {
        "console": "^0.1.0",
        "api": [
          "loams.approvals.v1"
        ]
      },
      "editions": [
        "oss",
        "desktop",
        "cloud"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
