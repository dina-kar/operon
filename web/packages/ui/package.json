{
  "name": "@loam/ui",
  "version": "0.1.0",
  "description": "Loam's design system: tokens, the mark, grain textures and React primitives.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dina-kar/operon",
    "directory": "web/packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css",
      "./tokens.css": "./src/tokens.css"
    }
  },
  "files": [
    "dist",
    "src/*.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
