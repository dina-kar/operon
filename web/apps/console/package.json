{
  "name": "@loams/console",
  "version": "0.1.0",
  "private": true,
  "description": "The Loams console: one single-page app for OSS, Loams Cloud and BYOC (design §19 P1).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "gen:api": "openapi-typescript ../../../api/console/openapi.json -o src/api/schema.d.ts",
    "test": "vitest run && node --test deploy/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@loams/console-host": "workspace:*",
    "@loams/cordis": "workspace:*",
    "@loams/example-plugin-hello": "workspace:*",
    "@loams/platform-web": "workspace:*",
    "@loams/plugin-approvals": "workspace:*",
    "@loams/plugin-identity": "workspace:*",
    "@loams/plugin-namespaces": "workspace:*",
    "@loams/plugin-rpc": "workspace:*",
    "@loams/plugin-sandbox": "workspace:*",
    "@loams/plugin-shell": "workspace:*",
    "@loams/plugin-stack-status": "workspace:*",
    "@loams/proto": "workspace:*",
    "@loams/slots": "workspace:*",
    "@loams/ui": "workspace:*",
    "lucide-react": "1.48.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "exports": {
    "./cordis": "./src/cordis/start.ts",
    "./catalog/base.yml": "./catalog/base.yml"
  }
}
