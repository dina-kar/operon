{
  "name": "loams-web",
  "private": true,
  "description": "The Loams console and the @loams/ui design system (design §19).",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @loams/console dev",
    "build": "pnpm --filter @loams/ui build && pnpm --filter @loams/console build",
    "gen:api": "pnpm --filter @loams/console gen:api",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "5.9.3"
  }
}
